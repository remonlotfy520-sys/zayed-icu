rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function settingsPath() { return /databases/$(database)/documents/config/settings; }
    function me() { return get(userPath()).data; }
    function isActive() { return signedIn() && exists(userPath()) && me().active == true; }
    function isAdmin() { return isActive() && me().role == 'admin'; }
    function canWrite() { return isAdmin() || (isActive() && me().access == 'write'); }
    function canReadUnit(u) { return isAdmin() || (isActive() && u in me().units); }
    function canWriteUnit(u) { return isAdmin() || (isActive() && me().access == 'write' && u in me().units); }

    // إعدادات المستشفى: اسم المستشفى واللوجو والوحدات والقوائم
    match /config/settings {
      allow read: if true;   // مطلوبة لعرض اسم المستشفى في شاشة الدخول
      allow create: if signedIn() && request.resource.data.adminUid == request.auth.uid;
      allow update: if isAdmin() && request.resource.data.adminUid == resource.data.adminUid;
      allow delete: if false;
    }

    // المستخدمين: الأدمن فقط يضيف ويعدل
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isAdmin()
        || (request.auth.uid == uid
            && !exists(settingsPath())
            && getAfter(settingsPath()).data.adminUid == uid
            && request.resource.data.role == 'admin'
            && request.resource.data.active == true);
      allow update: if isAdmin();
      allow delete: if false;
    }

    // سجل المرضى المشترك (رعاية وداخلي)
    match /patients/{pid} {
      allow read: if isActive();
      allow create, update: if canWrite();
      allow delete: if false;
    }

    // الدخول: اليوزر يشوف الحالات الحالية لوحداته فقط، والأرشيف للأدمن
    match /admissions/{aid} {
      allow read: if isAdmin()
        || (resource.data.status == 'active' && canReadUnit(resource.data.unitId));
      allow create: if canWriteUnit(request.resource.data.unitId)
        && request.resource.data.status == 'active'
        && request.resource.data.createdBy == request.auth.uid
        && (isAdmin() || request.resource.data.admitAt > request.time - duration.value(25, 'h'));
      allow update: if isAdmin()
        || (resource.data.status == 'active'
            && canWriteUnit(resource.data.unitId)
            && canWriteUnit(request.resource.data.unitId)
            && request.resource.data.admitAt == resource.data.admitAt
            && request.resource.data.status == 'active');
      allow delete: if false;
    }

    // قفل السرير: يمنع تسجيل حالتين على نفس السرير
    match /beds/{bid} {
      allow read: if isActive();
      allow create: if canWriteUnit(request.resource.data.unitId)
        && bid == request.resource.data.unitId + '_' + string(request.resource.data.bed);
      allow delete: if canWriteUnit(resource.data.unitId);
      allow update: if false;
    }
  }
}
